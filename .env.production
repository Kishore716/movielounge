# Production Environment Variables for Vercel
# Update these values before deployment

# Server Configuration
NODE_ENV=production
PORT=3000

# JWT Configuration (CHANGE THIS!)
JWT_SECRET=your_super_secret_jwt_key_change_this_immediately
JWT_EXPIRES_IN=7d

# Database Configuration (Optional - for persistent storage)
# If not set, app uses in-memory storage (data lost on redeploy)
# For production, use a managed database service

# Option 1: MySQL/MariaDB
# DB_HOST=your-db-host.com
# DB_USER=your-username
# DB_PASSWORD=your-secure-password
# DB_NAME=cineluxe_db
# DB_PORT=3306

# Option 2: Recommended - Use PlanetScale (MySQL compatible, free tier)
# Get connection string from PlanetScale and set DB_HOST, DB_USER, DB_PASSWORD, DB_NAME

# OMDb API (if using movie search features)
OMDB_API_KEY=adcd241

# Application Settings
VERCEL_URL=your-app.vercel.app
